---
import PageHero from "../components/PageHero.astro";
import about from "../content/pages/about.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Billy Ready"
  description="Meet Billy Ready, a Mississippi pastor, Christian counselor, author, and songwriter sharing Christ-centered music and biblical encouragement."
>
  <PageHero
    eyebrow={about.heroEyebrow}
    title={about.heroTitle}
    intro={about.heroIntro}
  />

  <section class="section page-shell about-story">
    <div class="roles-stacked reveal" aria-label="Billy Ready’s roles">
      <span>Pastor.</span>
      <span>Christian Counselor.</span>
      <span>Author.</span>
      <span>Songwriter.</span>
    </div>
    <div class="body-copy reveal">
      {about.storyParagraphs.map((paragraph, index) => <p class:list={{ lead: index === 0 }}>{paragraph}</p>)}
    </div>
  </section>

  <section class="mission-section">
    <div class="page-shell reveal">
      <p class="eyebrow">{about.missionEyebrow}</p>
      <p class="mission-statement">
        {about.missionStart} <em>{about.missionSongs}</em> and <em>{about.missionEnd}</em>
      </p>
    </div>
  </section>

  <section class="section page-shell faith-layout">
    <div class="reveal">
      <p class="eyebrow">{about.faithEyebrow}</p>
      <h2>{about.faithTitle}</h2>
    </div>
    <div class="body-copy reveal">
      {about.faithParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</BaseLayout>
