---
import PageHero from "../components/PageHero.astro";
import { ministryEvents, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Invite Billy Ready"
  description="Request Billy Ready for a church concert, worship service, retreat, revival, conference, or Christ-centered special event."
>
  <PageHero
    eyebrow="Invite Billy"
    title="Let’s share the hope of Christ together."
    intro="Tell us a little about your church or event. A booking request starts a conversation—it does not create an obligation."
  />

  <section class="section page-shell booking-layout">
    <div class="booking-details reveal">
      <p class="eyebrow">Start here</p>
      <h2>We’d be honored to hear from you.</h2>
      <p>
        Whether you are planning a worship service, revival, retreat, conference, Christmas celebration, or community outreach, it would be a privilege to partner with you.
      </p>
      <div class="direct-contact">
        <span>Prefer to call?</span>
        <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
      </div>
      <p class="contact-note">Phone is currently the quickest direct way to reach Billy Ready Music.</p>
    </div>

    <form
      class="booking-form reveal"
      name="booking-request"
      method="POST"
      action="/booking-thanks"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="booking-request" />
      <p class="hidden-field">
        <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
      </p>
      <div class="field-row">
        <label>
          Your name <span aria-hidden="true">*</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          Church or organization
          <input name="organization" type="text" autocomplete="organization" />
        </label>
      </div>
      <div class="field-row">
        <label>
          Email address <span aria-hidden="true">*</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          Phone number <span aria-hidden="true">*</span>
          <input name="phone" type="tel" autocomplete="tel" required />
        </label>
      </div>
      <div class="field-row">
        <label>
          Event type
          <select name="event-type">
            <option value="">Select one</option>
            {ministryEvents.map((event) => <option value={event}>{event}</option>)}
          </select>
        </label>
        <label>
          Tentative date
          <input name="event-date" type="date" />
        </label>
      </div>
      <label>
        Tell us about your event <span aria-hidden="true">*</span>
        <textarea name="message" rows="6" required placeholder="Location, congregation size, service format, and anything else that would help…"></textarea>
      </label>
      <label class="consent-field">
        <input name="consent" type="checkbox" value="yes" required />
        <span>I agree that Billy Ready Music may use this information to respond to my request.</span>
      </label>
      <button class="button button--dark" type="submit">Send booking request</button>
    </form>
  </section>
</BaseLayout>
