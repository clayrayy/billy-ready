---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Confirm Your Email" description="Check your inbox to complete your Billy Ready Music subscription." noindex>
  <section class="confirmation page-shell">
    <p class="eyebrow">One more step</p>
    <h1>Check your inbox.</h1>
    <p>Click the confirmation link from Billy Ready Music to complete your subscription. If it does not arrive soon, check your spam or promotions folder.</p>
    <a class="button button--dark" href="/music">Explore the songs</a>
  </section>
</BaseLayout>
