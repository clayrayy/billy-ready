---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const songs = await getCollection("songs");
  return songs.map((song) => ({ params: { slug: song.id }, props: { song } }));
}

interface Props {
  song: CollectionEntry<"songs">;
}

const { song } = Astro.props;
const { Content } = await render(song);
const schema = {
  "@context": "https://schema.org",
  "@type": "MusicRecording",
  name: song.data.title,
  description: song.data.summary,
  url: new URL(`/songs/${song.id}`, Astro.site).href,
  byArtist: {
    "@type": "Person",
    name: "Billy Ready",
  },
};
---

<BaseLayout title={song.data.title} description={song.data.summary} schema={schema}>
  <article class="song-story">
    <header class="song-story__hero page-shell">
      <a class="back-link hero-enter hero-enter--1" href="/music">← All songs</a>
      <p class="eyebrow hero-enter hero-enter--1">Behind the song</p>
      <h1 class="hero-enter hero-enter--2">{song.data.title}</h1>
      <p class="song-story__summary hero-enter hero-enter--3">{song.data.summary}</p>
      {song.data.scripture && <p class="scripture-ref hero-enter hero-enter--3">Inspired by {song.data.scripture}</p>}
    </header>
    <div class="song-story__body page-shell reveal">
      <div class="prose"><Content /></div>
      <aside>
        <p class="eyebrow">{song.data.listenUrl ? "Listen" : "Release details"}</p>
        {song.data.listenUrl ? (
          <a class="button button--dark" href={song.data.listenUrl} target="_blank" rel="noopener">Play this song</a>
        ) : (
          <p>Streaming and purchase information will be added when the release link is confirmed.</p>
        )}
        <a class="text-link" href="/book">Invite Billy to share it live <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </article>
</BaseLayout>
