---
import { getCollection } from "astro:content";
import NewsletterForm from "../components/NewsletterForm.astro";
import { ministryEvents } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/billy-ready-hero.webp";

const songs = (await getCollection("songs")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout transparentHeader>
  <section class="home-hero">
    <div class="home-hero__visual" data-hero-image>
      <img
        src={heroImage.src}
        alt="A well-worn acoustic guitar resting beside a church pew in warm evening light"
        width={heroImage.width}
        height={heroImage.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="home-hero__shade"></div>
    <div class="home-hero__content page-shell">
      <p class="eyebrow hero-enter hero-enter--1">Christ-centered songs · Honest stories</p>
      <h1 class="hero-enter hero-enter--2">Billy Ready <span>Music</span></h1>
      <p class="hero-tagline hero-enter hero-enter--3">Music for the<br />Journey Home.</p>
      <p class="hero-copy hero-enter hero-enter--4">
        Every song is a prayer that your heart will be pointed to Jesus Christ.
      </p>
      <div class="hero-actions hero-enter hero-enter--4">
        <a class="button button--light" href="/music">Explore the songs</a>
        <a class="text-link text-link--light" href="/book">Invite Billy <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <a class="hero-scroll" href="#story" aria-label="Continue to Billy’s story"><span></span>Scroll to the story</a>
  </section>

  <section id="story" class="story-section section page-shell">
    <div class="story-heading reveal">
      <p class="eyebrow">Every song has a story</p>
      <h2>Sometimes God’s answer to discouragement is another song.</h2>
    </div>
    <div class="story-copy reveal">
      <p class="lead">
        Some songs are born out of celebration. Others come through disappointment, unanswered prayers, and quiet moments when God whispers, “Keep going.”
      </p>
      <p>
        After a deeply discouraging response to one of his songs, Billy seriously considered laying songwriting aside. Instead, God began filling his heart with new melodies—reminders that the calling had not changed.
      </p>
      <a class="text-link" href="/songs/he-keeps-me-singing">Read the story of He Keeps Me Singing <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="music-section section">
    <div class="page-shell">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Featured songs</p>
          <h2>Hope for the road you’re walking.</h2>
        </div>
        <a class="text-link" href="/music">Explore all music <span aria-hidden="true">→</span></a>
      </div>
      <ol class="song-list reveal">
        {songs.map((song, index) => (
          <li>
            <span class="song-number">{String(index + 1).padStart(2, "0")}</span>
            <a href={`/songs/${song.id}`}>
              <span class="song-title">{song.data.title}</span>
              <span class="song-summary">{song.data.summary}</span>
              <span class="song-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="testimony-band ministry-quote">
    <div class="page-shell testimony-layout reveal">
      <p class="eyebrow">The heart of the ministry</p>
      <div>
        <blockquote>“God’s faithfulness is greater than life’s greatest storms.”</blockquote>
        <p class="quote-attribution">— Billy Ready</p>
        <div class="quote-rule" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="ministry-preview section page-shell">
    <div class="ministry-intro reveal">
      <p class="eyebrow">Encouraging hearts through music</p>
      <h2>More than a concert.</h2>
      <p>
        Based in Mississippi, Billy partners with churches and Christian organizations for gatherings centered on worship, God’s Word, and His faithfulness.
      </p>
      <a class="button button--dark" href="/book">Request a booking</a>
    </div>
    <div class="event-list reveal">
      <p class="list-label">Available ministry events</p>
      <ul>
        {ministryEvents.slice(0, 8).map((event) => <li>{event}</li>)}
      </ul>
      <a class="text-link" href="/ministry">See the ministry approach <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="about-preview">
    <div class="page-shell about-preview__inner">
      <p class="eyebrow reveal">About Billy</p>
      <p class="roles reveal">Pastor. <em>Christian Counselor.</em><br />Author. <em>Songwriter.</em></p>
      <div class="about-preview__copy reveal">
        <p>
          For decades, God has allowed Billy to serve people through pastoral ministry, Christian counseling, writing, and music—all with one purpose: helping people discover God’s faithfulness in every season of life.
        </p>
        <a class="text-link text-link--light" href="/about">Meet Billy <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="newsletter-section">
    <div class="page-shell newsletter-layout reveal">
      <div>
        <p class="eyebrow">Stay connected</p>
        <h2>A little encouragement for the journey.</h2>
        <p>Receive occasional devotionals, behind-the-song stories, ministry updates, and new music announcements.</p>
      </div>
      <NewsletterForm />
    </div>
  </section>
</BaseLayout>
