---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { EditablePage } from "../types/page-builder";
import EditableHero from "./EditableHero.astro";
import PageBuilder from "./PageBuilder.astro";

interface Props {
  page: EditablePage;
  transparentHeader?: boolean;
}

const { page, transparentHeader = false } = Astro.props;
const songs = (await getCollection("songs")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={page.seo.image}
  imageAlt={page.seo.imageAlt}
  transparentHeader={transparentHeader}
>
  <EditableHero hero={page.hero} />
  <PageBuilder sections={page.sections} songs={songs} />
</BaseLayout>
