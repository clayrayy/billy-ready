---
import { ministryEvents } from "../data/site";
---

<form
  class="booking-form reveal"
  name="booking-request"
  method="POST"
  action="/booking-thanks"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <input type="hidden" name="form-name" value="booking-request" />
  <p class="hidden-field">
    <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
  </p>
  <div class="field-row">
    <label>Your name <span aria-hidden="true">*</span><input name="name" type="text" autocomplete="name" required /></label>
    <label>Church or organization<input name="organization" type="text" autocomplete="organization" /></label>
  </div>
  <div class="field-row">
    <label>Email address <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" required /></label>
    <label>Phone number <span aria-hidden="true">*</span><input name="phone" type="tel" autocomplete="tel" required /></label>
  </div>
  <div class="field-row">
    <label>
      Event type
      <select name="event-type">
        <option value="">Select one</option>
        {ministryEvents.map((event) => <option value={event}>{event}</option>)}
      </select>
    </label>
    <label>Tentative date<input name="event-date" type="date" /></label>
  </div>
  <label>
    Tell us about your event <span aria-hidden="true">*</span>
    <textarea name="message" rows="6" required placeholder="Location, congregation size, service format, and anything else that would help…"></textarea>
  </label>
  <label class="consent-field">
    <input name="consent" type="checkbox" value="yes" required />
    <span>I agree that Billy Ready Music may use this information to respond to my request.</span>
  </label>
  <button class="button button--dark" type="submit">Send booking request</button>
</form>
